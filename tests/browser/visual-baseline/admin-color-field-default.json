{
  ".colorfield": {
    "minWidth": "168px"
  },
  ".colorfield > label": {
    "color": "rgb(29, 35, 39)",
    "fontSize": "13px",
    "fontWeight": "600"
  },
  ".colorfield .clr-field": {
    "display": "block",
    "width": "880px"
  },
  ".colorfield .clr-field input": {
    "backgroundColor": "rgb(255, 255, 255)",
    "color": "rgb(100, 105, 112)",
    "borderColor": "rgb(220, 220, 222)",
    "borderRadius": "3px",
    "paddingLeft": "44px",
    "fontFamily": "ui-monospace, SFMono-Regular, Consolas, monospace"
  },
  ".colorfield__off": {
    "color": "rgb(100, 105, 112)",
    "fontSize": "12.5px",
    "gap": "6px",
    "marginTop": "6px"
  }
}
